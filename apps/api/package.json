{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --local --test-scheduled",
    "build": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .local-data/build",
    "cf:types": "wrangler types --config wrangler.jsonc src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply dropthing-local --config wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply dropthing-production --config wrangler.production.jsonc --remote",
    "db:reset:local": "bun run scripts/reset-local.ts",
    "validate:r2:remote": "bun run scripts/validate-r2-remote.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.54",
    "@dropthing/shared": "workspace:0.0.1",
    "ai": "7.0.126",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/bun": "1.4.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "wrangler": "4.145.0"
  }
}
