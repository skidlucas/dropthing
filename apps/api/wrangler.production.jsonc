{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dropthing-production",
  "account_id": "4ee3596aa154bb4e0509c39e98f4a25c",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGIN": "https://dropthing.mtnz.app",
    "R2_BUCKET_NAME": "dropthing",
    "R2_PREFIX": "production",
    "R2_PUBLIC_URL": "https://cdn-dropthing.mtnz.app/production",
    "R2_ACCOUNT_ID": "4ee3596aa154bb4e0509c39e98f4a25c",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropthing-production",
      "database_id": "ef0a50c9-edcd-44e4-ab76-6ab3a224179b",
      "migrations_dir": "d1",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dropthing" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "redact_query_string": true },
  "routes": [{ "pattern": "dropthing.mtnz.app", "custom_domain": true }],
}
