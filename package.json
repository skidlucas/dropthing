{
  "name": "dropthing",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "type-check": "tsc --build --noEmit",
    "compose": "docker compose up -d",
    "compose:down": "docker compose down",
    "prepare": "husky && effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.2",
    "@effect/vitest": "4.0.0-beta.70",
    "api": "workspace:0.0.1",
    "dotenv": "17.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,yml,yaml}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  }
}
