{
  "name": "dropthing",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build",
    "db:migrate:local": "bun run --cwd apps/api db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/api db:migrate:remote",
    "db:reset:local": "bun run --cwd apps/api db:reset:local",
    "type-check": "tsc --build --noEmit",
    "prepare": "husky && effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "4.0.0",
    "api": "workspace:0.0.1",
    "dotenv": "18.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,yml,yaml}": [
      "oxfmt --write"
    ]
  }
}
